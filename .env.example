# Copy to .env and fill in when credentials arrive. NEVER commit .env.

# --- Meta WhatsApp Cloud API ---
# Leave WHATSAPP_TOKEN blank to run offline: sends are logged as [MOCK SEND].
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App secret enables x-hub-signature-256 verification. Blank = verification skipped.
WHATSAPP_APP_SECRET=
# Any string you choose; paste the same one into the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --- LLM ---
# mock (default, offline) | anthropic | openai
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=

# --- Google Sheets (the live sheet the salon owner reads on her phone) ---
# Path to the service-account JSON. Blank = offline, logs [MOCK SHEETS].
GOOGLE_SHEETS_CREDENTIALS_FILE=
# The long id in the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Bookings

# --- Salon (optional overrides for app/config.py) ---
SALON_NAME=
SALON_ADDRESS=
SALON_PHONE=

# --- Tuning ---
SESSION_TTL_SECONDS=3600
DEDUPE_TTL_SECONDS=600

# --------------------------------------------------------------------------- #
# CORS — which browser origins may call /api/*
# --------------------------------------------------------------------------- #
# Comma-separated. REPLACES the defaults (localhost:3000, 127.0.0.1:3000) when
# set, so include local dev here if you set it at all. Leave blank in Vercel:
# the regex below already covers the deployed frontend.
CORS_ALLOW_ORIGINS=

# Regex for origins that cannot be enumerated — Vercel gives every preview
# deployment its own hostname. Defaults to any https://<name>.vercel.app.
# Set this once the site moves to its own domain.
CORS_ALLOW_ORIGIN_REGEX=
