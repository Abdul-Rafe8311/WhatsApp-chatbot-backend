# Sonia's Makeup Salon — frontend environment
#
# This is a static Next.js export (next.config.ts sets output: "export"), so
# NEXT_PUBLIC_* values are inlined into the bundle at BUILD time. Changing one
# in the Vercel dashboard needs a redeploy to take effect — there is no server
# reading env at runtime.
#
# Nothing here is required. With this file absent the site builds, and the chat
# widget still resolves a backend: localhost when you are on localhost, the
# deployed API otherwise. Set the variable to override that.

# Base URL of the FastAPI booking agent, no trailing slash.
# Local backend:     http://127.0.0.1:8000
# Deployed backend:  https://whats-app-chatbot-backend.vercel.app
# Read by src/lib/api.ts, used by src/components/ChatWidget.tsx.
NEXT_PUBLIC_API_URL=https://whats-app-chatbot-backend.vercel.app
