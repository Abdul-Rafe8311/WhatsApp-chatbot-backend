# Sonia's Makeup Salon — frontend environment
#
# As of this commit the frontend reads NO environment variables at all. It is a
# static Next.js export (next.config.ts sets output: "export") that ships plain
# HTML/CSS/JS, and every outbound link — WhatsApp, Instagram, Facebook, Google
# Maps — is a literal URL in src/config/. The site builds and runs with this
# file absent and with nothing set in the Vercel dashboard.
#
# The variable below is declared for the chat widget integration that does not
# exist in this app yet. Nothing consumes it today; adding it to Vercel changes
# nothing until code reads it. It is here so the name is settled in advance.

# Base URL of the FastAPI backend, no trailing slash.
# Local backend:      http://127.0.0.1:8000
# Deployed backend:   https://whats-app-chatbot-backend.vercel.app
NEXT_PUBLIC_API_URL=https://whats-app-chatbot-backend.vercel.app
